#!/usr/bin/env python3
"""Old name for `mfactory`. An upgrade from 0.1.0 runs this to sync."""

import sys
from pathlib import Path

if sys.version_info < (3, 11):  # noqa: UP036
    sys.exit("mfactory: needs Python 3.11 or later (found %d.%d)" % sys.version_info[:2])  # noqa: UP031

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

from modfactory.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
